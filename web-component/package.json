{
  "name": "@fiojs/wc-circular-slider",
  "version": "1.0.1",
  "description": "Accessible, form-associated circular slider and arc gauge Web Component.",
  "type": "module",
  "license": "MIT",
  "author": "Fio Seehawer",
  "repository": { "type": "git", "url": "https://github.com/fseehawer/react-circular-slider.git", "directory": "web-component" },
  "homepage": "https://fseehawer.github.io/react-circular-slider/web-component/",
  "main": "./dist/node/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "node": "./dist/node/index.js", "default": "./dist/index.js" },
    "./register": { "types": "./dist/register.d.ts", "node": "./dist/node/register.js", "default": "./dist/register.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["./dist/register.js", "./dist/node/register.js"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p demo/tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "test:browser": "playwright test",
    "build:demo": "npm run build && vite build --config demo/vite.config.ts",
    "dev": "npm run build && vite --config demo/vite.config.ts --host 127.0.0.1 --port 5188 --strictPort"
  },
  "dependencies": { "lit": "^3.3.1" },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.11.1",
    "lucide": "^0.468.0",
    "rollup": "^4.0.0",
    "rollup-plugin-dts": "^6.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
