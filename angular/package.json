{
  "name": "circular-slider-angular-workspace",
  "private": true,
  "scripts": {
    "build": "ng-packagr -p projects/ng-circular-slider/ng-package.json -c projects/ng-circular-slider/tsconfig.lib.json",
    "build:demo": "npm run build && ng build demo --configuration production",
    "dev": "npm run build && ng serve demo --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:consumer": "node scripts/check-consumer.mjs",
    "test:browser": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "pack": "npm run build && npm pack ./dist/ng-circular-slider",
    "publish:package": "npm run build && npm publish ./dist/ng-circular-slider --access public"
  },
  "dependencies": {
    "@angular/common": "20.3.30",
    "@angular/compiler": "20.3.30",
    "@angular/core": "20.3.30",
    "@angular/forms": "20.3.30",
    "@angular/platform-browser": "20.3.30",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.36",
    "@angular/cli": "20.3.36",
    "@angular/compiler-cli": "20.3.30",
    "@angular/platform-browser-dynamic": "20.3.30",
    "@angular/platform-server": "20.3.30",
    "@playwright/test": "^1.58.2",
    "ng-packagr": "20.3.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
